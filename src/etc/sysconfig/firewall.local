# 1. Initialize variables
CONFIG_DIR="/etc/sysconfig/fw.local"
HOSTS_DIR="${CONFIG_DIR}/hosts"
START_SUFFIX="_start.sh"
STOP_SUFFIX="_stop.sh"
DEBUG="${DEBUG:-false}"

# 2. Source library - ShellCheck SC1090/SC1091 Fix
# Pointing to the source file relative to repo root for dev-time validation
# SC1090 Fix: Tell ShellCheck we intend for this to be dynamic
# shellcheck source=/dev/null 
if [ -f "/usr/local/bin/firewall_functions" ]; then
    . /usr/local/bin/firewall_functions
else
    logger -t "FIREWALL_LOCAL" "[ERROR] Library missing: /usr/local/bin/firewall_functions"
    exit 1
fi

# 3. Define functions
run_scripts() {
    # Pseudocode: Source modular scripts in current shell context
    local suffix="${1}"
    local script=""

    for script in "${CONFIG_DIR}"/*"${suffix}"; do
        [ -x "${script}" ] || continue
        
        log_event "INFO" "Executing modular script: ${script}"
        # SC1090 Fix: Tell ShellCheck we intend for this to be dynamic
        # shellcheck source=/dev/null
        if ! . "${script}"; then
            log_event "ERROR" "Execution failed: ${script}"
        fi
    done
}

# 4. Main Execution Logic
case "$1" in
    start)
        log_event "INFO" "Starting firewall-local modular load..."
        
        # Validate environment before making changes
        validate_env || exit 1

        # Phase 1: Process Master Lists (SST)
        log_event "INFO" "Starting process_asn_master_list apply asn_master.list ..."
        [ -f "${HOSTS_DIR}/asn_master.list" ] && process_asn_master_list "apply" "${HOSTS_DIR}/asn_master.list"
        log_event "INFO" "Starting process_ip_master_list apply ip_master.list ..."
        [ -f "${HOSTS_DIR}/ip_master.list" ] && process_ip_master_list "apply" "${HOSTS_DIR}/ip_master.list"
        log_event "INFO" "Starting process_smb_master_list apply smb_master.list ..."
        [ -f "${HOSTS_DIR}/smb_master.list" ] && process_smb_master_list "apply" "${HOSTS_DIR}/smb_master.list"

        # Phase 2: Run legacy modular scripts
        run_scripts "${START_SUFFIX}"
        ;;

    stop)
        log_event "INFO" "Stopping firewall-local modules..."

        # Phase 1: Reverse Master Lists
        log_event "INFO" "Starting process_asn_master_list remove asn_master.list..."
        [ -f "${HOSTS_DIR}/asn_master.list" ] && process_asn_master_list "remove" "${HOSTS_DIR}/asn_master.list"
        log_event "INFO" "Starting process_ip_master_list remove ip_master.list..."
        [ -f "${HOSTS_DIR}/ip_master.list" ] && process_ip_master_list "remove" "${HOSTS_DIR}/ip_master.list"
        log_event "INFO" "Starting process_smb_master_list remove smb_master.list..."
        [ -f "${HOSTS_DIR}/smb_master.list" ] && process_smb_master_list "remove" "${HOSTS_DIR}/smb_master.list"

        # Phase 2: Run legacy stop scripts
        run_scripts "${STOP_SUFFIX}"
        ;;

    reload)
        log_event "INFO" "Reloading firewall-local..."
        "$0" stop
        "$0" start
        ;;

    *)
        log_event "WARNING" "Unknown action: $1 - Ignoring."
        exit 0
        ;;
esac