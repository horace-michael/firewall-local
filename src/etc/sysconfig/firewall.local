#!/bin/bash
###############################################################################
# firewall.local – modular firewall loader (verbose)
# VERSION="3.0.0 2026-03-05"
# AUTHOR="H&M"
# see CHANGELOG.md for details
###############################################################################

# 1. Initialize variables first
CONFIG_DIR="/etc/sysconfig/fw.local/"
START_SUFFIX="_start.sh"
STOP_SUFFIX="_stop.sh"
DEBUG="${DEBUG:-false}"

# 2. Source library - ShellCheck SC1091 Fix
# shellcheck source=/dev/null
. /usr/local/bin/firewall_functions

run_scripts() {
    local SUFFIX="$1"
    for script in "$CONFIG_DIR"/*"$SUFFIX"; do
        [ -x "$script" ] || continue
        log_event "INFO" "executing $script"
        if ! bash -c ". '$script'"; then
            log_event "ERROR" "failed to execute $script"
        fi
    done
}

case "$1" in
    start)
        log_event "INFO" "starting module load"
        run_scripts "$START_SUFFIX"
        ;;

    stop)
        log_event "INFO" "stopping modules - unloading"
        run_scripts "$STOP_SUFFIX"
	# v2.5.1 - CUSTOM_chains_stop.sh
        ;;

    reload)
        log_event "INFO" "reload"
        $0 stop
        $0 start
        ;;

    *)
        log_event "WARNING" "unknown action $1, ignoring"
        exit 0
        ;;
esac
