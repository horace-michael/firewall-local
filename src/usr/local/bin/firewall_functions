# 1. Initialize variables 
DEBUG="${DEBUG:-false}"
LOG_TAG="FIREWALL_LOCAL"

# 2. Define functions
log_event() {
    # Pseudocode: Dual logging to syslog and STDOUT if DEBUG is active
    local level="${1}"
    local message="${2}"
    
    # Machine Log (Always active for audit)
    logger -t "${LOG_TAG}" "[${level}] ${message}"
    
    # Dev Style Output (Active only if DEBUG=true)
    [ "${DEBUG}" = true ] && printf "[DEBUG] [%s] %s\n" "${level}" "${message}"
}

validate_env() {
    # Pseudocode: Confirm IPFire identity and directory structure
    [ "${DEBUG}" = true ] && log_event "DEBUG" "Verifying environment integrity..."
    
    # Check both conditions directly to avoid SC2181
    if [ -d "/var/ipfire" ] && grep -q "ipfire" /etc/os-release 2>/dev/null; then
        log_event "INFO" "IPFire environment detected successfully."
        return 0
    else
        log_event "ERROR" "IPFire environment not detected!"
        return 1
    fi
}

generate_ipset_from_asn_list() {
    # Function: generate_ipset_from_asn_list
    # Pseudocode:
    # 1. Create a unique temporary set.
    # 2. Populate temporary set via 'location' and 'restore'.
    # 3. Swap temporary set with live set (Atomic).
    # 4. Cleanup temporary set.

    local asn="${1}"
    local action="${2:-DROP}" 
    local target_name="AS${asn}_${action}"
    local temp_name="${target_name}_tmp"
    local ipset_file="/tmp/${temp_name}.ipset"

    # 1. Fetch data and modify the set name in the dump file to use temp_name
    # 'location' outputs 'create AS<num>v4' - we sed it to temp_name
    location list-networks-by-as --format=ipset --family=ipv4 "${asn}" | \
        sed "s/AS${asn}v4/${temp_name}/g" > "${ipset_file}"
    
    # 2. Restore the temporary set into memory
    ipset restore < "${ipset_file}"
    
    # 3. Atomic Swap
    # If target_name doesn't exist, we rename. If it does, we swap.
    if ipset list "${target_name}" >/dev/null 2>&1; then
        log_event "INFO" "Live swapping ${target_name} with new data."
        ipset swap "${temp_name}" "${target_name}"
        ipset destroy "${temp_name}"
    else
        log_event "INFO" "First time creation of ${target_name}."
        ipset rename "${temp_name}" "${target_name}"
    fi
    
    # Cleanup
    rm -f "${ipset_file}"
    log_event "INFO" "SST Update Complete: ${target_name}"
}

apply_ipset_in_table_chain_action_src_or_dst() {
    # Function: apply_ipset_in_table_chain_action_src_or_dst
    # Pseudocode:
    # 1. Initialize local variables for IPset Name, Chain, and Action.
    # 2. Validate that the IPset exists in kernel memory.
    # 3. Check if the specified Chain exists in the filter/nat table.
    # 4. If logging is enabled, insert a LOG rule before the action rule.
    # 5. Insert rule in table - chain using the defined Action (-j DROP, -j RETURN, etc) and desired direction (src or dst).
    
    local set_name="${1}"
    local table="${2:-filter}"
    local chain="${3:-FORWARDFW}"
    local action="${4:-RETURN}"
    local src_dst="${5:-dst}"
    local log_enabled="${6:-false}"
    
    # Verify IPset exists before applying
    if ! ipset list "${set_name}" >/dev/null 2>&1; then
        log_event "ERROR" "IPset ${set_name} not found in kernel. Skipping."
        return 1
    fi

    # Check chain existence to avoid iptables errors
    if ! iptables -t "${table}" -L "${chain}" >/dev/null 2>&1; then
        log_event "WARNING" "Chain ${chain} in table ${table} not found."
        return 1
    fi

    log_event "INFO" "Applying ${action} for ${set_name} in ${table}:${chain}"
    
    # Logic: Insert at top to ensure bypass/drop occurs before general rules
    iptables --wait -t "${table}" -I "${chain}" -m set --match-set "${set_name}" "${src_dst}" -j "${action}"

    # Inject LOG rule if requested
    if [ "${log_enabled}" = "true" ]; then
        log_event "DEBUG" "Adding LOG rule for ${set_name} in ${chain}"
        iptables --wait -t "${table}" -I "${chain}" -m set --match-set "${set_name}" "${src_dst}" \
            -j LOG --log-prefix "IPSET:${set_name} " --log-level 4
    fi
}

remove_ipset_from_table_chain_action_src_or_dst() {
    # Function: remove_ipset_from_table_chain_action_src_or_dst
    # Pseudocode:
    # 1. Initialize local variables for IPset Name, Table, Chain, Action, Direction, and Log status.
    # 2. Check if the IPset exists in kernel memory to validate context.
    # 3. If logging was enabled, verify rule existence before removal.
    # 4. Remove the action rule (DROP, RETURN, etc) only if 'iptables -C' confirms it exists.
    # 5. Use 2>/dev/null || true for maximum reliability during shutdown/restart.

    local set_name="${1}"
    local table="${2:-filter}"
    local chain="${3:-FORWARDFW}"
    local action="${4:-RETURN}"
    local src_dst="${5:-dst}"
    local log_enabled="${6:-false}"

    # Verify IPset exists before attempting removal
    if ! ipset list "${set_name}" >/dev/null 2>&1; then
        log_event "DEBUG" "IPset ${set_name} not found. Skipping rule cleanup."
        return 0
    fi

    # Remove LOG rule if it was requested during start
    if [ "${log_enabled}" = "true" ]; then
        log_event "DEBUG" "Removing LOG rule for ${set_name} in ${chain}"
        # Bullet-proof check: verify before delete
        iptables -t "${table}" -C "${chain}" -m set --match-set "${set_name}" "${src_dst}" \
            -j LOG --log-prefix "IPSET:${set_name} " --log-level 4 2>/dev/null && \
        iptables --wait -t "${table}" -D "${chain}" -m set --match-set "${set_name}" "${src_dst}" \
            -j LOG --log-prefix "IPSET:${set_name} " --log-level 4 2>/dev/null
    fi

    log_event "INFO" "Removing ${action} rule for ${set_name} from ${table}:${chain}"
    
    # Remove final action rule only if it exists
    iptables -t "${table}" -C "${chain}" -m set --match-set "${set_name}" "${src_dst}" -j "${action}" 2>/dev/null && \
    iptables --wait -t "${table}" -D "${chain}" -m set --match-set "${set_name}" "${src_dst}" -j "${action}" 2>/dev/null
}

process_asn_master_list() {
    # Function: process_asn_master_list
    # Pseudocode:
    # 1. Validate IPFire environment integrity.
    # 2. Check for the existence of the master list file.
    # 3. Read the config line-by-line; ignore comments/empty lines.
    # 4. For each entry, verify the IPset is present in kernel memory.
    # 5. Iterate through the chains list and trigger the apply/remove function.
    
    local mode="${1:-apply}"
    local list_path="${2:-/etc/sysconfig/fw.local/hosts/asn_master.list}"
    local asn table action dir log_en chains c
    local set_name

    # 1. Environment Validation
    if ! validate_env; then
        log_event "ERROR" "Environment validation failed. Aborting."
        return 1
    fi

    # 2. Configuration File Validation
    if [ ! -f "${list_path}" ]; then
        log_event "ERROR" "Master list file not found at: ${list_path}"
        return 1
    fi

    [ "${DEBUG}" = true ] && log_event "DEBUG" "Processing master list: ${list_path} [Mode: ${mode}]"

    while read -r asn table action dir log_en chains || [ -n "${asn}" ]; do
        # Skip comments and empty lines
        [[ "${asn}" =~ ^#.*$ || -z "${asn}" ]] && continue

        # Construct set name consistently
        set_name="AS${asn}v4"

        # 3. Kernel Integrity Check: Ensure IPset is loaded
        if ! ipset list "${set_name}" >/dev/null 2>&1; then
            log_event "WARNING" "IPset ${set_name} missing from kernel. Skipping."
            continue
        fi

        # 4. Chain Iteration and Rule Execution
        for c in ${chains}; do
            if [ "${mode}" == "apply" ]; then
                apply_ipset_in_table_chain_action_src_or_dst "${set_name}" "${table}" "${c}" "${action}" "${dir}" "${log_en}"
            else
                remove_ipset_from_table_chain_action_src_or_dst "${set_name}" "${table}" "${c}" "${action}" "${dir}" "${log_en}"
            fi
        done
    done < "${list_path}"
}

process_ip_line() {
    # Function to process agnostic IP/CIDR rules
    local obj="${1}" table="${2}" action="${3}" dir="${4}" proto="${5}" ports="${6}" chains="${7}"
    local dir_flag ports_cmd proto_cmd
    
    # Set Direction Flag
    [ "${dir}" == "src" ] && dir_flag="-s" || dir_flag="-d"
    
    # Set Protocol and Ports logic
    if [ "${proto}" == "all" ] || [ "${ports}" == "all" ]; then
        proto_cmd=""
        ports_cmd=""
    else
        proto_cmd="-p ${proto}"
        ports_cmd="-m multiport --dports ${ports}"
    fi

    for chain in ${chains}; do
        # Verify chain existence before applying
        if iptables -t "${table}" -L "${chain}" >/dev/null 2>&1; then
            # Check for existing rule to avoid duplicates (Jack Reacher: Avoid Redundancy)
            iptables -t "${table}" -C "${chain}" ${dir_flag} "${obj}" "${proto_cmd}" "${ports_cmd}" -j "${action}" 2>/dev/null || \
            iptables --wait -t "${table}" -I "${chain}" ${dir_flag} "${obj}" "${proto_cmd}" "${ports_cmd}" -j "${action}"
        fi
    done
}

process_ip_master_list() {
    local list_path="${1:-/etc/sysconfig/fw.local/hosts/ip_master.list}"
    local mode="${2:-apply}" # Initialize variables first
    local obj table action dir proto ports chains clean_line clean_ip

    [ -f "$list_path" ] || return 1

    while read -r raw_line || [ -n "$raw_line" ]; do
        # 1. Strip CR and leading/trailing whitespace
        clean_line=$(echo "${raw_line}" | tr -d '\r' | xargs)
        [[ "$clean_line" =~ ^#.*$ || -z "$clean_line" ]] && continue
        
        # 2. Parse from cleaned line to avoid " tcp" errors
        read -r obj table action dir proto ports chains <<< "$clean_line"
        
        # 3. Clean each variable (Jack Reacher Rule)
        proto=$(echo "$proto" | xargs)
        
        [ "${DEBUG}" = "true" ] && printf "[DEBUG] [IP_LINE] Obj: %s Proto: %s\n" "$obj" "$proto"

        if [ -f "/etc/sysconfig/fw.local/hosts/${obj}.hosts" ]; then
            # Logic for .hosts files...
            while read -r line || [ -n "$line" ]; do
                clean_ip=$(echo "$line" | sed 's/#.*//' | xargs)
                [ -n "$clean_ip" ] && process_ip_line "$clean_ip" "$table" "$action" "$dir" "$proto" "$ports" "$chains"
            done < "/etc/sysconfig/fw.local/hosts/${obj}.hosts"
        else
            process_ip_line "$obj" "$table" "$action" "$dir" "$proto" "$ports" "$chains"
        fi
    done < "$list_path"
}

resolve_smb_source_ip() {
    # Pseudocode:
    # 1. Validate IPFire environment.
    # 2. Check if customhosts file exists and is non-zero size.
    # 3. Search for fragment, extracting the 4th field (IP).
    # 4. Return IP string or return error code 1.
    local host_fragment="${1}"
    local hosts_file="${2:-/var/ipfire/fwhosts/customhosts}"
    local match
    local src_ip

    # 1. Verify IPFire environment via library function
    if ! validate_env; then
        log_event "ERROR" "Environment check failed. Not an IPFire system."
        return 1
    fi

    # 2. Check file existence and size
    if [ ! -s "${hosts_file}" ]; then
        log_event "ERROR" "Hosts file missing or empty: ${hosts_file}"
        return 1
    fi

    # 3. Resolve IP of a given part of a hostname (fragment) using the customhosts file
    match=$(grep -i "${host_fragment}" "${hosts_file}" | grep ',ip,' | head -n1)
    
    if [ -n "${match}" ]; then
        src_ip=$(echo "${match}" | awk -F',' '{print $4}' | cut -d'/' -f1)
        printf "%s" "${src_ip}"
        return 0
    else
        log_event "WARNING" "No IP found for Host fragment: ${host_fragment}"
        return 1
    fi
}

process_smb_master_list() {
    # Pseudocode: Iterates through the SMB master list and applies iptables rules.
    # 1. Validate file existence.
    # 2. Loop through lines, resolving the source fragment to a real IP.
    # 3. Apply multiport rules for SMB ports (135,137,138,139,445,1025).

    # 1. Initialize variables first
    local list_path="${2:-/etc/sysconfig/fw.local/hosts/smb_master.list}"
    local mode="${1:-apply}"
    local host_fragment="" action="" target_ip="" src_ip=""
    local smb_ports="135,137,138,139,445,1025"
    local ipt_cmd=""
    local clean_line=""

    # 1. Verify environment
    if ! validate_env; then
        log_event "ERROR" "Environment check failed."
        return 1
    fi

    # 2. Check file
    if [ ! -s "${list_path}" ]; then
        log_event "ERROR" "SMB list file missing/empty: ${list_path}"
        return 1
    fi

    # Set command type based on mode
    [ "${mode}" == "apply" ] && ipt_cmd="-I" || ipt_cmd="-D" 

    # Debug: Identify which list is being processed
    [ "${DEBUG}" = "true" ] && printf "[DEBUG] [SMB_MASTER] Mode: %s Path: %s\n" "${mode}" "${list_path}"

    while read -r raw_line || [ -n "${raw_line}" ]; do
        # Strip CR and leading/trailing whitespace to fix " tcp" error
        clean_line=$(echo "${raw_line}" | tr -d '\r' | xargs)
        
        # Skip comments and empty lines
        [[ "${clean_line}" =~ ^#.*$ || -z "${clean_line}" ]] && continue

        # Parse from cleaned line
        read -r host_fragment action target_ip <<< "${clean_line}"
        
        # Sanitize individual variables (Jack Reacher Rule: Assumption kills)
        host_fragment=$(echo "${host_fragment}" | xargs)
        action=$(echo "${action}" | xargs)
        target_ip=$(echo "${target_ip}" | xargs)

        [ "${DEBUG}" = "true" ] && printf "[DEBUG] [SMB_LINE] Frag: %s Act: %s IP: %s\n" "${host_fragment}" "${action}" "${target_ip}"

        if src_ip=$(resolve_smb_source_ip "${host_fragment}"); then
            log_event "INFO" "SMB ${action}: ${host_fragment}(${src_ip}) -> ${target_ip}"
            
            # Use sanitized variables to avoid " tcp" protocol error
            iptables --wait -t filter "${ipt_cmd}" CUSTOMFORWARD -s "${src_ip}" -d "${target_ip}" \
                -p tcp -m multiport --dports "${smb_ports}" -j "${action}" 2>/dev/null || true 
        else
            log_event "WARNING" "SMB: Could not resolve IP for ${host_fragment}" 
        fi
    done < "${list_path}"
}